# API Base URL configuration
# For local development with Vite dev server proxy (/api -> http://localhost:3000),
# leave both VITE_BACKEND_URL and VITE_API_URL empty so requests use same-origin /api.
# In production or separate host environments, set VITE_BACKEND_URL (or legacy VITE_API_URL)
# to the backend base URL (e.g. https://watchwise-backend-production.up.railway.app).
VITE_BACKEND_URL=
VITE_API_URL=

# Optional Cloudinary configuration for avatar uploads
# Intentionally left unset for standard local development.
# If avatar uploads are required, configure your public cloud name and unsigned upload preset:
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
# VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
